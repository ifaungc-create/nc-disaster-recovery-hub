  "name": "nc-disaster-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "data": "python3 scripts/build_data.py && node scripts/make-sitemap.mjs",
    "test:unit": "node tests/functions.test.mjs && node tests/admins.test.mjs && node tests/push.test.mjs && node tests/i18n.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:e2e:local && npm run test:a11y",
    "test:a11y": "node tests/a11y.mjs",
    "icons": "node scripts/make-icons.mjs",
    "linkcheck": "python3 scripts/linkcheck.py data-raw/resource_urls.json",
    "test:e2e:local": "E2E_ADAPTER=local SHOTS_DIR=/tmp/ncdrh-local-shots/ node tests/e2e.mjs",
    "sitemap": "node scripts/make-sitemap.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.48.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@ebarooni/capacitor-calendar": "^8.10.0",
    "@netlify/blobs": "^11.1.6",
    "qrcode-generator": "^1.4.4",
    "web-push": "^3.6.7"
  }
}
